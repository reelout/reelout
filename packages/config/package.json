{
  "name": "@reelout/config",
  "version": "0.7.2",
  "description": "Discovers, merges, and normalizes ReelOut configuration, including plugin registrations.",
  "keywords": [
    "release",
    "versioning",
    "monorepo",
    "configuration",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reelout/reelout.git",
    "directory": "packages/config"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "module": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "module": "./src/*.ts",
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "./dist",
    "./src"
  ],
  "scripts": {
    "build": "vite build --ssr --sourcemap",
    "dev": "vite build --ssr --watch"
  },
  "dependencies": {
    "@reelout/cargo": "workspace:^",
    "@reelout/core": "workspace:^",
    "@reelout/git": "workspace:^",
    "@reelout/github": "workspace:^",
    "@reelout/gitlab": "workspace:^",
    "@reelout/npm": "workspace:^",
    "cosmiconfig": "catalog:",
    "lodash-es": "catalog:"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:"
  },
  "engines": {
    "node": ">=24.15"
  },
  "publishConfig": {
    "access": "public"
  }
}
