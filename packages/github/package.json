{
  "name": "@reelout/github",
  "version": "0.8.0",
  "description": "GitHub plugin for publishing releases from ReelOut release plans.",
  "keywords": [
    "release",
    "versioning",
    "github",
    "releases",
    "octokit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reelout/reelout.git",
    "directory": "packages/github"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "module": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "module": "./src/*.ts",
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "./dist",
    "./src"
  ],
  "scripts": {
    "build": "vite build --ssr --sourcemap",
    "dev": "vite build --ssr --watch"
  },
  "dependencies": {
    "@octokit/rest": "catalog:",
    "@reelout/core": "workspace:^"
  },
  "engines": {
    "node": ">=24.15"
  },
  "publishConfig": {
    "access": "public"
  }
}
