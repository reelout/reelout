{
  "name": "@reelout/context",
  "version": "0.4.1",
  "description": "Creates the release execution context from Git state, resolved configuration, and runtime options.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reelout/reelout.git",
    "directory": "packages/context"
  },
  "license": "MIT",
  "type": "module",
  "imports": {},
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "module": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "module": "./src/*.ts",
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "./dist",
    "./src"
  ],
  "scripts": {
    "build": "vite build --ssr --sourcemap",
    "dev": "vite build --ssr --watch"
  },
  "dependencies": {
    "@reelout/config": "workspace:^",
    "@reelout/core": "workspace:^",
    "consola": "catalog:"
  },
  "engines": {
    "node": ">=24.15"
  }
}
