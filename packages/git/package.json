{
  "name": "@reelout/git",
  "version": "0.10.0",
  "description": "Git plugin for creating release commits, pushing tags, and rolling back tags on failure.",
  "keywords": [
    "release",
    "versioning",
    "git",
    "tags",
    "commits"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reelout/reelout.git",
    "directory": "packages/git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "module": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "module": "./src/*.ts",
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "./dist",
    "./src"
  ],
  "scripts": {
    "build": "vite build --ssr --sourcemap",
    "dev": "vite build --ssr --watch"
  },
  "dependencies": {
    "@reelout/core": "workspace:^"
  },
  "engines": {
    "node": ">=24.15"
  },
  "publishConfig": {
    "access": "public"
  }
}
