{
  "name": "reelout",
  "version": "0.15.0",
  "description": "Plugin-driven release automation for monorepos, with built-in npm and Cargo support.",
  "keywords": [
    "release",
    "monorepo",
    "versioning",
    "changelog",
    "conventional-commits",
    "npm",
    "cargo",
    "git",
    "github",
    "gitlab",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reelout/reelout.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "module": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "module": "./src/*.ts",
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "bin": "dist/cli.js",
  "files": [
    "./dist",
    "./src"
  ],
  "scripts": {
    "build": "pnpm -r build && vite build --ssr --sourcemap",
    "clean": "rimraf -g \"**/{coverage,dist,generated}\"",
    "dev": "concurrently \"pnpm -r --parallel dev\" \"vite build --ssr --watch\"",
    "format": "eslint --fix . && prettier --write .",
    "lint": "eslint . && prettier --check . && tsx scripts/check.ts .",
    "prepare": "husky",
    "test": "vitest",
    "validate": "pnpm i && pnpm clean && pnpm lint && typedoc --out generated && pnpm build && pnpm test run --coverage"
  },
  "dependencies": {
    "@reelout/cli": "workspace:^",
    "@reelout/config": "workspace:^",
    "@reelout/context": "workspace:^",
    "@reelout/core": "workspace:^"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@reelout/github": "workspace:^",
    "@reelout/npm": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "concurrently": "catalog:",
    "consola": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import": "catalog:",
    "from-async": "catalog:",
    "glob": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "ignore": "catalog:",
    "lint-staged": "catalog:",
    "memfs": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "rollup-plugin-node-externals": "catalog:",
    "sort-package-json": "catalog:",
    "tempy": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unionfs": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "engines": {
    "node": ">=24.15"
  }
}
