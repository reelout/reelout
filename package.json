{
  "name": "reelout",
  "version": "0.2.2",
  "description": "Plugin-driven release automation for JavaScript and TypeScript monorepos.",
  "keywords": [
    "release",
    "monorepo",
    "versioning",
    "changelog",
    "conventional-commits",
    "npm",
    "git",
    "github",
    "gitlab",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reelout/reelout.git"
  },
  "license": "MIT",
  "type": "module",
  "imports": {},
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "module": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "module": "./src/*.ts",
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "bin": "dist/cli.js",
  "files": [
    "./dist",
    "./src"
  ],
  "scripts": {
    "build": "pnpm -r build && vite build --ssr --sourcemap",
    "clean": "rimraf -g **/{*.tsbuildinfo,coverage,dist,generated,storybook-static,test-results}",
    "dev": "concurrently 'pnpm -r --parallel dev' 'vite build --ssr --watch'",
    "format": "eslint --fix . && prettier --write .",
    "lint": "eslint . && prettier --check . && tsx scripts/check.ts .",
    "prepare": "husky",
    "test": "vitest",
    "validate": "pnpm i && pnpm clean && pnpm lint && typedoc --out generated && pnpm build && pnpm test run --coverage"
  },
  "dependencies": {
    "@reelout/cli": "workspace:^",
    "@reelout/config": "workspace:^",
    "@reelout/context": "workspace:^",
    "@reelout/core": "workspace:^"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@eslint/js": "catalog:",
    "@reelout/github": "workspace:^",
    "@reelout/npm": "workspace:^",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "concurrently": "catalog:",
    "consola": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import": "catalog:",
    "from-async": "catalog:",
    "glob": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "ignore": "catalog:",
    "jsdom": "catalog:",
    "lint-staged": "catalog:",
    "memfs": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "rollup-plugin-node-externals": "catalog:",
    "sort-package-json": "catalog:",
    "tempy": "catalog:",
    "tslib": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unionfs": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=24.15"
  }
}
